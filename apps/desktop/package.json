{
  "name": "@agent-lens/desktop",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "main": "src/bootstrap.mjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-windows-icon.ps1 && electron-builder --win nsis",
    "dist:win:dir": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-windows-icon.ps1 && electron-builder --win dir"
  },
  "dependencies": {
    "electron": "41.0.2"
  },
  "devDependencies": {
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "dev.agentlens.desktop",
    "productName": "AgentLens",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*",
      "runtime/**/*",
      "assets/**/*"
    ],
    "files": [
      "src/**/*",
      "runtime/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": ".electron-dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-app.ico",
      "artifactName": "AgentLens-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentLens",
      "deleteAppDataOnUninstall": false
    }
  }
}
