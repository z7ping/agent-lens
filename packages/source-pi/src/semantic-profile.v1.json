  "fallback": {
    "kind": "unknown",
    "preserveRaw": true,
    "semanticSource": "unknown"
  },
  "knownButOutOfScope": {
    "reference": "pi-web live event stream",
    "reason": "这些是运行时/UI 生命周期，不属于 Pi Session JSONL v3 的持久化 entry；本轮只登记，不强行映射成 History 事实。",
    "events": [
      "connected",
      "agent_start",
      "agent_end",
      "agent_settled",
      "prompt_done",
      "prompt_error",
      "extension_error",
      "message_start",
      "message_update",
      "message_end",
      "tool_execution_start",
      "tool_execution_update",
      "tool_execution_end",
      "queue_update",
      "auto_retry_start",
      "auto_retry_end",
      "auto_compaction_start",
      "compaction_start",
      "auto_compaction_end",
      "compaction_end",
      "extension_ui_request",
      "extension_ui_closed"
    ]
  },
  "notes": [
    "Pi 官方 SessionEntry 当前包含 message / thinking_level_change / model_change / usage / compaction / branch_summary / custom / custom_message / label / session_info。",
    "Pi 官方 Message/AgentMessage 语义覆盖 system / user / assistant / toolResult，以及 coding-agent 扩展 bashExecution / custom / branchSummary / compactionSummary。",
    "Pi StopReason 是 Assistant 消息完成/状态元数据，不等同于 Turn 生命周期：stop/toolUse 不再制造独立生命周期事件；length/error/aborted/pending/deferred 保留明确状态。",
    "toolUse 表示继续进入工具执行；length 表示输出被截断；pending 是未 settle 的流式状态。",
    "bashExecution 是 message role，不是当前官方 SessionEntry 顶层类型；历史兼容的 bash/bash_result 只按 passthrough 保留。",
    "未知 entry、未知 StopReason 或未知 Assistant block 必须 preserveRaw=true。"
  ]
}
